APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# First-party dashboard: exact origins for CORS, host:port values for Sanctum.
DASHBOARD_ORIGINS=http://localhost:3000,http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173
SANCTUM_TOKEN_EXPIRATION=43200
# Set true when deploying behind HTTPS in production.
SESSION_SECURE_COOKIE=false

# HTTPS app/dashboard reset page; no query string or fragment.
AUTH_PASSWORD_RESET_URL=
# Dedicated mailer: never use log or a failover that logs credentials.
AUTH_PASSWORD_RESET_MAILER=smtp

# Comma-separated trusted Google OAuth client IDs (backend audience and mobile presenters).
GOOGLE_CLIENT_IDS=

ALADHAN_BASE_URL=https://api.aladhan.com/v1
QURAN_BASE_URL=https://api.alquran.cloud/v1

# Explicit AdminSeeder/UserSeeder only (local/testing). Minimum 12 characters.
SEED_ACCOUNT_PASSWORD="password@123"
